<div class="input-group phone-input-group @CustomContainerClass">
    @if (IncludeCountrySelect)
    {
        @if (IncludeContinentSelect)
        {
            <!-- Dropdown for continent -->
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle
                    @Border dropdown-fixed-btn continent-btn @CustomContinentButtonClass"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        style="min-width: @ContinentMinWidth; @(!string.IsNullOrEmpty(ContinentMaxWidth) ? $"max-width: {ContinentMaxWidth};" : "")">
                    @if (SelectedContinent != null)
                    {
                        @SelectedContinent.GetDescription()
                    }
                    else
                    {
                        <span>Select Continent</span>
                    }
                </button>
                <ul class="dropdown-menu dropdown-menu-scrollable @CustomDropdownMenuClass">
                    @foreach (var continent in Enum.GetValues(typeof(ContinentEnum)).Cast<ContinentEnum>())
                    {
                        <li>
                            <a class="dropdown-item"
                               href="#" @onclick="() => OnContinentSelect(continent)">
                                @continent.GetDescription()
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Dropdown for country -->
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle
                @Border dropdown-fixed-btn country-btn @CustomCountryButtonClass"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    style="min-width: @CountryMinWidth;@(!string.IsNullOrEmpty(CountryMaxWidth) ? $"max-width: {CountryMaxWidth};" : "")">
                @if (SelectedCountry != null)
                {
                    @if (ShowFlags && !string.IsNullOrEmpty(SelectedCountry.CountryIsoAlpha2))
                    {
                        <img src="@SelectedCountry.FlagPath(FlagFormat)" alt="" class="dropdown-flag" style="width: @FlagWidth; height: @FlagHeight;" />
                    }

                    <span>@SelectedCountry.CountryName</span>
                }
                else
                {
                    <span>Select Country</span>
                }
            </button>
            <ul class="dropdown-menu dropdown-menu-scrollable @CustomDropdownMenuClass">
                @foreach (var country in FilteredCountries)
                {
                    <li>
                        <a class="dropdown-item dropdown-item-custom"
                           href="#" @onclick="() => OnCountrySelect(country)">
                            @if (ShowFlags && !string.IsNullOrEmpty(country.CountryIsoAlpha2))
                            {
                                <img src="@country.FlagPath(FlagFormat)" alt="" class="dropdown-flag" style="width: @FlagWidth; height: @FlagHeight;" />
                            }
                            <span>@country.CountryName (@country.CountryCallCode)</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }

    <!-- Phone number input -->
    <input id="phone-number"
           type="tel"
           class="form-control @Border @CustomInputClass"
           placeholder="@(RequiredPlaceholder ? RequiredValueValidationMessage : Placeholder)"
           autocomplete="@AutoComplete"
           value="@PhoneNumber"
           required="@ShowStandardRequiredMessage"
           style="@(!string.IsNullOrEmpty(InputMinWidth) ? $"min-width: {InputMinWidth};" : "") @(!string.IsNullOrEmpty(InputMaxWidth) ? $"max-width: {InputMaxWidth};" : "")"
           @onchange="OnPhoneNumberChange" />
</div>