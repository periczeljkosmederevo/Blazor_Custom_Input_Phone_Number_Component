@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<br />
<br />

<EditForm Model=@VM OnSubmit="OnSubmit">
    <DataAnnotationsValidator />

    <div class="row">
        <div class="col-6">
            <PhoneNumberInput @bind-PhoneNumber="@VM.Number"
                              @bind-SelectedCountry="@VM.Country"
                              IsRequired="true"
                              ShowFlags="true"
                              IncludeContinentSelect="false"
                              ContinentMinWidth="10rem"
                              CountryMinWidth="10rem"/>
        </div>
    </div>
    <br />
    <br />

    <p>
        User has selected continent:
        <span>@(VM.Country?.ContinentName)</span>
    </p>

    <p>
        User has selected country:
        <span>@VM.Country?.CountryName with country calling code @VM.Country?.CountryCallCode</span>
    </p>

    <p>
        User has selected phonenumber:
        <span>@VM.FormatedNumber</span>
    </p>

    <ValidationSummary />

    <button type="submit" class="btn btn-primary">Save</button>

</EditForm>